{
  "name": "compakta",
  "version": "1.3.2",
  "private": true,
  "type": "module",
  "description": "Local GUI for compressing and converting photos and videos with include/exclude control, budget estimates, verification and safe undo",
  "license": "MIT",
  "author": "Compakta contributors",
  "engines": {
    "bun": ">=1.1.0"
  },
  "scripts": {
    "dev": "bun run --hot src/server.ts",
    "start": "bun run src/server.ts",
    "start:open": "bun run src/server.ts --open",
    "desktop:dev": "electrobun dev --watch",
    "desktop:prepare": "electrobun prepare",
    "desktop:build": "electrobun build --env=stable",
    "desktop:build:full": "bun run scripts/build-full-desktop.ts",
    "desktop:build:canary": "electrobun build --env=canary",
    "release:check": "bun run scripts/check-release-version.ts",
    "build:client": "bun build src/client/main.ts --outfile public/app.js --target browser",
    "typecheck": "bunx tsc -p tsconfig.json",
    "lint": "bun run typecheck",
    "check": "bun run build:client && bun run typecheck && bun run src/client.check.ts && bun run src/platform.check.ts && bun run src/format.check.ts && bun run src/video.check.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^26.6.5",
    "electrobun": "2.0.5",
    "typescript": "^7.0.2"
  }
}
